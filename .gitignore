# macOS
.DS_Store
._*

# Editor and shell backups
*~
*.swp

# Local scratch
*.pyc
__pycache__/
harvest/idmap_cache/
harvest/citations/cache/
harvest/authors/cache/
harvest/repos/_ghcache/

# Fulltext lane: cached publisher-fetched PDFs' extracted text must not be
# pushed. Only the aggregate manifest is committed. Abstracts (metadata, not
# publisher text) are the exception -- they're committed in full.
harvest/fulltext/*/
!harvest/fulltext/manifest.json
!harvest/fulltext/abstracts/
!harvest/fulltext/abstracts/**

# classify-corpus: the dry-run request dump is a large, regenerable scratch
# artifact (re-run `curate/classify_citations.py --submit --dry-run` to
# rebuild it) -- only the staging records and batch state are committed.
harvest/taxonomy/records/_requests_dry_run.json
harvest/repos/_verify_requests_dry_run.json
harvest/impactview/owner-repos.json
harvest/impactview/personal-repos-pool.json
